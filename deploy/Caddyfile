			dbadmin $2a$14$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG
		}
		reverse_proxy cloudbeaver:8978
	}

	reverse_proxy frontend:3000
}
