TECH_RO_PASSWORD=replace_with_strong_readonly_password
TECH_ADMIN_PASSWORD=replace_with_strong_admin_password

# Опционально: если поднимаете Caddy (HTTPS) на сервере — раскомментируйте:
# BEHIND_TLS_PROXY=1
# VITE_APP_HOST=demo2dev.ru

# Опционально: включить SQL логирование SQLAlchemy в backend (только временно для отладки)
# SQL_ECHO=1

# Опционально: логировать старт/финиш HTTP-запросов в backend
# HTTP_REQUEST_LOGS=1

# Опционально: доступ в CloudBeaver (web-клиент к БД)
# CLOUDBEAVER_ADMIN_NAME=admin
# CLOUDBEAVER_ADMIN_PASSWORD=replace_with_strong_cloudbeaver_password
